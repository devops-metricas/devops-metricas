    {
      "name": "1. Una notificación",
      "item": [
        {
          "name": "1a. Enviar (202)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/v1/notifications",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v1",
                "notifications"
              ]
            },
            "description": "202 = recibida y registrada, no entregada.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"recipient\": \"ana@example.test\",\n  \"channel\": \"internal\",\n  \"subject\": \"Hola\",\n  \"body\": \"Demo en vivo\",\n  \"idempotency_key\": \"demo-1\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.id) pm.collectionVariables.set('id', j.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "1b. Estado e historial",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
